<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- aapt2 versions an adaptive icon to v26 and then cannot find it from
         the manifest when it sits in an unqualified anydpi folder. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!-- ImageProxy.getImage() — the only way an analyzer reaches the pixels
         CameraX handed it — has carried this marker for years without the
         API changing. Lint cannot see @OptIn through the analyzer lambda,
         so the opt-in is made project-wide here instead. -->
    <issue id="UnsafeOptInUsageError">
        <option name="opt-in" value="androidx.camera.core.ExperimentalGetImage" />
    </issue>
</lint>
