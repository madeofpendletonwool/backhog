# Copy to .env and fill in. Only the IGDB credentials are required.

# --- IGDB metadata (required for game search) -------------------------------
# IGDB is authenticated through Twitch. To get credentials:
#   1. Sign in at https://dev.twitch.tv/console/apps
#   2. "Register Your Application" — any name, OAuth Redirect URL
#      http://localhost, Category "Application Integration"
#   3. Copy the Client ID, then "New Secret" for the Client Secret
# Without these the app still runs, but adding new games is disabled.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Steam import (optional) -------------------------------------------------
# Enables bulk-importing an owned Steam library. This is a single developer key
# for the whole deployment, not a per-user secret: one key can read any *public*
# Steam profile, so users only supply their own SteamID.
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Books media library (optional) -------------------------------------------
# Read-only library roots, colon-separated. The Books arena never uploads
# files: it inventories whatever is mounted at these paths — mp3/m4a/m4b for
# audiobooks, epub for text. Anything else (.aax, .aaxc, DRM-wrapped epub) is
# skipped and reported as unsupported. Mount the NAS directories into the api
# service read-only (see docker-compose.yml) and list the container-side
# paths here. BOOK_LIBRARY_DIR is honoured as an alias.
# Example: MEDIA_DIR=/media/audiobooks:/media/ebooks
MEDIA_DIR=

# EPUB canonical texts and their offset indexes live as files here, next to
# the database — see docker-compose.yml. Defaults to ./epub_text when unset;
# only worth changing outside of compose.
EPUB_TEXT_DIR=

# --- Optional ---------------------------------------------------------------
# Host port to publish the web UI on.
PORT=8080

# Set to true ONLY if you serve Backhog over HTTPS (e.g. behind Caddy, Traefik,
# or nginx with TLS). On plain HTTP over a LAN address, a Secure cookie is
# silently dropped by the browser and login will appear to do nothing.
COOKIE_SECURE=false
