# Copy to .env and fill in. Only the IGDB credentials are required.

# --- IGDB metadata (required for game search) -------------------------------
# IGDB is authenticated through Twitch. To get credentials:
#   1. Sign in at https://dev.twitch.tv/console/apps
#   2. "Register Your Application" — any name, OAuth Redirect URL
#      http://localhost, Category "Application Integration"
#   3. Copy the Client ID, then "New Secret" for the Client Secret
# Without these the app still runs, but adding new games is disabled.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Steam import (optional) -------------------------------------------------
# Enables bulk-importing an owned Steam library. This is a single developer key
# for the whole deployment, not a per-user secret: one key can read any *public*
# Steam profile, so users only supply their own SteamID.
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Books media library (optional) -------------------------------------------
# Read-only library roots, colon-separated. The Books arena never uploads
# files: it inventories whatever is mounted at these paths — mp3/m4a/m4b/opus
# for audiobooks, epub for text. Anything else is skipped and reported with a
# reason: DRM (.aax, .aaxc, DRM-wrapped epub) and Kindle formats (.mobi, .azw,
# .azw3) are both out of scope, while a Calibre .opf is read for the title,
# author and ISBN it carries and used to match the books beside it. Mount the
# NAS directories into the api service read-only (see docker-compose.yml) and
# list the container-side paths here. BOOK_LIBRARY_DIR is honoured as an alias.
# Example: MEDIA_DIR=/media/audiobooks:/media/ebooks
MEDIA_DIR=

# --- Alignment worker (optional) ---------------------------------------------
# Shared secret authenticating the optional alignment worker container
# against the API's /internal endpoints. Generate one with:
#   openssl rand -hex 32
# Set it (identically in the worker) to enable alignment jobs; leave it
# empty and the whole Books arena keeps working — alignment only unlocks
# the reading↔listening handoff. The token is never logged.
ALIGN_WORKER_TOKEN=

# The two numbers that decide whether a finished alignment is published
# ('ready') or kept and labelled ('low_confidence'): the fraction of the
# book its anchors span, and their mean confidence. Defaults are 0.80 and
# 0.60, chosen from the measurements in align/cmd/alignbench — an
# unabridged reading covers essentially the whole book at any usable
# transcript quality, a 55%-abridged reading covers 0.55, and the wrong
# book covers nothing. Leave empty unless an alignment you trust is being
# rejected (or one you do not is being published).
ALIGN_MIN_COVERAGE=
ALIGN_MIN_CONFIDENCE=

# Which Whisper model the worker image bakes in — a BUILD argument, so
# changing it means `docker compose --profile align build`, not a restart.
# tiny.en ~75 MB, base.en ~148 MB (default; roughly 30–90 minutes of CPU
# for an 11-hour book), small.en ~488 MB (more accurate, ~3x slower),
# medium.en ~1.5 GB.
WHISPER_MODEL=base.en

# Transcription threads inside the worker. Leave empty to use every core
# the container is allowed.
WHISPER_THREADS=

# --- OCR lettering worker (optional) -----------------------------------------
# Makes comics, manga and picture books searchable: an optional worker
# container reads the drawn lettering off each page image into a
# search-only corpus. Its own profile and its own token — enable it with
# `docker compose --profile ocr up`, independently of alignment.
# Generate the shared secret with: openssl rand -hex 32
# Leave it empty and lettering search does not exist; every other feature,
# including searching text-native books, is unaffected.
OCR_WORKER_TOKEN=

# The ready/low_confidence thresholds a finished corpus is graded against:
# the share of pages that yielded any lettering, and the mean per-page
# confidence. Defaults 0.30 and 0.60 — judgment numbers, not measured
# ones: stylized lettering is best-effort, and a sparse corpus stays
# searchable once it says so.
OCR_MIN_COVERAGE=
OCR_MIN_CONFIDENCE=

# Tesseract's page segmentation mode inside the worker. Default 11
# (sparse text — balloons and captions); 3 (tesseract's own default) suits
# pages of scanned prose.
OCR_TESSERACT_PSM=

# Tesseract language (a traineddata baked into the worker image). The
# shipped image carries English only; anything else is a rebuild.
OCR_LANGUAGE=


# EPUB canonical texts and their offset indexes live as files here, next to
# the database — see docker-compose.yml. Defaults to ./epub_text when unset;
# only worth changing outside of compose.
EPUB_TEXT_DIR=

# --- Optional ---------------------------------------------------------------
# Host port to publish the web UI on.
PORT=8080

# Set to true ONLY if you serve Backhog over HTTPS (e.g. behind Caddy, Traefik,
# or nginx with TLS). On plain HTTP over a LAN address, a Secure cookie is
# silently dropped by the browser and login will appear to do nothing.
COOKIE_SECURE=false
